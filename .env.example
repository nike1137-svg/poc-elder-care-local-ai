# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 .gitignore 로 제외되어 있습니다.
#
#   cp .env.example .env
#
# ── 기준선(baseline) 재현용 ────────────────────────────────────────────
# Google AI Studio 무료 키: https://aistudio.google.com/apikey
# 개선안(로컬 Whisper)만 돌린다면 이 키는 필요 없습니다.
GEMINI_API_KEY=

# 기준선에 쓸 모델. 실서비스가 쓰는 계열에 맞춥니다.
GEMINI_MODEL=gemini-flash-latest

# ── 개선안(로컬 Whisper) 설정 ─────────────────────────────────────────
# tiny / base / small / medium / large-v3
WHISPER_MODEL=small
# int8(CPU 권장) / float16(GPU) / float32
WHISPER_COMPUTE=int8
